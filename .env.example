# Copy to .env (git-ignored). All values are optional; defaults are safe for local use.

# Host port published on 127.0.0.1 only.
WEB_PORT=8080

# OCR engine: paddle | mock. Inference engine for paddle: onnxruntime (arm64/x86_64) | paddle_static (x86_64 only).
MT_OCR_ENGINE=paddle
MT_OCR_INFERENCE_ENGINE=onnxruntime
MT_OCR_VERSION=PP-OCRv5
MT_OCR_DET_MODEL=PP-OCRv5_mobile_det
MT_OCR_REC_MODEL=PP-OCRv5_mobile_rec
# Detection input size (longer side, px). Larger = better recall on small kana, more RAM/time.
MT_OCR_DET_LIMIT_SIDE_LEN=1600
MT_OCR_DET_LIMIT_TYPE=max
# Second detection pass at a smaller size for bold/large text (0 = off).
MT_OCR_DET_SECONDARY_SIDE_LEN=960
# manga-ocr for Japanese regions: auto (only low-confidence) | always_ja | off
MT_MANGA_OCR_ENABLED=1
MT_MANGA_OCR_MODE=auto
MT_MANGA_OCR_MIN_CONFIDENCE=0.7

# Rendering: erase only the text strokes (inpainting) so bubble outlines and art survive.
# Set to 0 to go back to painting a flat box over the whole region.
MT_RENDER_INPAINT=1
# Inpainting backend: auto (LaMa when /models/lama/lama_fp32.onnx exists, else OpenCV Telea) | lama | telea.
# Fetch the LaMa model (~200 MB, Apache-2.0) with `make lama-model`, or let the worker download it on
# first use with MT_LAMA_AUTO_DOWNLOAD=1.
MT_RENDER_INPAINT_MODEL=auto
MT_LAMA_AUTO_DOWNLOAD=0
# Typography: text outline 0 = never, 1 = only on complex backgrounds, 2 = always; font size cap =
# original glyph size × MT_RENDER_GLYPH_SCALE (× MT_RENDER_GLYPH_SCALE_LATIN when the target uses a Latin font).
MT_RENDER_HALO=1
MT_RENDER_GLYPH_SCALE=1.25
MT_RENDER_GLYPH_SCALE_LATIN=1.4
# Font files (absolute, or relative to MT_FONT_DIR=/usr/share/fonts). Bundled: Patrick Hand (vi/en), Noto Sans CJK.
#MT_RENDER_FONT_LATIN=truetype/patrickhand/PatrickHand-Regular.ttf
#MT_RENDER_FONT_CJK=opentype/noto/NotoSansCJK-Regular.ttc

# Limits
MT_MAX_UPLOAD_BYTES=26214400
# Whole-request budget (bytes, default 256 MiB). Must stay <= nginx `client_max_body_size` (256m in
# frontend/nginx.conf) and below the api tmpfs (512m) / memory (768M) in compose.yaml: file parts are spooled
# to tmpfs, which counts against the container's memory. Raise all of them together.
MT_MAX_UPLOAD_TOTAL_BYTES=268435456
MT_MAX_PAGES_PER_UPLOAD=100
MT_MAX_PAGES_PER_PROJECT=500
MT_MAX_IMAGE_PIXELS=40000000
MT_MAX_AI_CONCURRENCY=2
MT_MAX_CHARS_PER_JOB=200000
MT_PROVIDER_TIMEOUT_SECONDS=60
MT_PROVIDER_MAX_RESPONSE_BYTES=2000000

# Custom Responses-compatible endpoints: comma-separated host allowlist (admin-controlled).
MT_ENDPOINT_ALLOWLIST=tokenplan.api.greennode.ai
# Admin-only switch to permit private/internal endpoints (never enable on a shared host).
MT_ALLOW_INTERNAL_ENDPOINTS=0

# Model download source for PaddleX: bos | huggingface | modelscope | aistudio
PADDLE_PDX_MODEL_SOURCE=bos

# Build-time only, read by the Makefile (and Compose build args). Opt-in for Apple Silicon VMs that advertise SME
# without SVE (Podman applehv on M4): 1 = build with backend/requirements-compat-sme-vm.txt (older cryptography /
# onnxruntime pins that carry known advisories; local use only). Never enabled automatically; `make doctor` shows
# whether your VM needs it. Leave unset/0 everywhere else.
#COMPAT_SME_VM=1
